# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
supabase/.temp
supabase/functions/.env

# vitest
/coverage

# local tooling
.claude/

# fetch caches for scripts/ (re-downloaded on demand; never read at runtime)
# Harvest inputs and cache: 748 MB, and the database is the source of truth for what is
# published. These stay on the machine that harvests. tests/seed.test.ts skips itself when
# they are absent, so a deploy does not fail over files that are deliberately not here.
/data
